# Supabase — pegue em Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave service_role (SERVIDOR APENAS — nunca exponha no client)
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site (usada em OG, sitemap, links de proposta/briefing)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# E-mail (Resend) — notificações para o admin
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=contato@amagostudio.com.br
EMAIL_FROM="Âmago Studio <no-reply@amagostudio.com.br>"

# Contato do studio (usado em CTAs)
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/5500000000000
NEXT_PUBLIC_CONTACT_EMAIL=contato@amagostudio.com.br
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/amago.studio
